# 服务端配置模板（真实 Key 勿提交）
PROXY_PORT=8088
PROXY_KEY=sk-proxy-CHANGE_ME

# 上游：OpenCode Go 的 Anthropic 兼容端点
UPSTREAM_URL=https://opencode.ai/inference/go/anthropic/
UPSTREAM_KEY=CHANGE_ME_OPENCODE_KEY
UPSTREAM_MODEL=deepseek-v4.1-flash

# 代理入口前缀（客户端实际请求路径），与上游路径相互独立
PROXY_PREFIX=/api/anthropic/

NGINX_CONF_DST=/etc/nginx/conf.d/aiproxy.conf
